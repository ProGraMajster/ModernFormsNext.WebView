<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Keep the requested build configuration on source references outside this solution. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>

    <Authors>ProGraMajster</Authors>
    <Company>ProGraMajster</Company>
    <Copyright>Copyright (c) 2026 ProGraMajster</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ProGraMajster/ModernFormsNext.WebView</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ProGraMajster/ModernFormsNext.WebView</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
