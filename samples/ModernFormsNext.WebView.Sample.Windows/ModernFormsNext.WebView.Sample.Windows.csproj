<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>ModernFormsNext.WebView.Sample.Windows</AssemblyName>
    <RootNamespace>ModernFormsNext.WebView.Sample.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ModernFormsNext.WebView.Windows/ModernFormsNext.WebView.Windows.csproj" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Shared/test-page.html" Link="test-page.html" />
    <EmbeddedResource Include="../Shared/LocalContent/*" Link="LocalContent/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
