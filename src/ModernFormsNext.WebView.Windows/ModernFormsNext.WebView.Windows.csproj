<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>ModernFormsNext.WebView.Windows</AssemblyName>
    <RootNamespace>ModernFormsNext.WebView.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ModernFormsNext.WebView/ModernFormsNext.WebView.csproj" />
    <!-- Consume Core/loader here. SDK buildTransitive targets also add WPF/WinForms
         wrappers to unrelated consumers; project references already propagate our
         resolved Core assembly and loader content without importing those targets. -->
    <PackageReference Include="Microsoft.Web.WebView2" PrivateAssets="contentfiles;analyzers;build;buildTransitive" />
    <ProjectReference Include="$(ModernFormsNextSourceRoot)/ModernFormsNext.WindowKit.Backend.Windows/ModernFormsNext.WindowKit.Backend.Windows.csproj" Condition="'$(ModernFormsNextSourceRoot)' != ''" />
  </ItemGroup>
</Project>
