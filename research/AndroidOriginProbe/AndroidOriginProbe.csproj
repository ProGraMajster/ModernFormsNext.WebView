<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AndroidApplication>true</AndroidApplication>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <ApplicationId>com.programajster.modernformsnext.webview.originprobe</ApplicationId>
    <ApplicationTitle>WebView origin research</ApplicationTitle>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-x64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.WebKit" />
    <PackageReference Include="HarfBuzzSharp" />
    <ProjectReference Include="../../src/ModernFormsNext.WebView.Android/ModernFormsNext.WebView.Android.csproj" />
  </ItemGroup>
</Project>
