<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Error-mapping tests consume native SDK enums directly, unlike ordinary WebView consumers. -->
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/ModernFormsNext.WebView.Windows/ModernFormsNext.WebView.Windows.csproj" />
    <!-- Compile the exact internal queue source for deterministic tests; no friend access. -->
    <Compile Include="../../src/ModernFormsNext.WebView.Windows/NavigationCommandQueue.cs" Link="NavigationCommandQueue.cs" />
    <Compile Include="../../src/ModernFormsNext.WebView.Windows/WindowsWebViewPolicy.cs" Link="WindowsWebViewPolicy.cs" />
    <Compile Include="../../src/ModernFormsNext.WebView.Windows/WindowsMessageGuard.cs" Link="WindowsMessageGuard.cs" />
  </ItemGroup>
</Project>
